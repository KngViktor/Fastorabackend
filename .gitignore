*.log
.DS_Store
.env
.env.backup
.env.production
# Catches any other *.env-named file (e.g. env2.env), not just the exact
# names above — one of those got committed with production DB credentials
# in it because its name didn't match any existing pattern.
*.env
.phpactor.json
.phpunit.result.cache
/.fleet
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
/auth.json
/node_modules
# /public/build is deliberately NOT ignored, for the same reason as /vendor:
# this host cannot run npm during deploy, so the compiled Filament theme has to
# be committed. After editing resources/css/filament/admin/theme.css, run
# `npm run build` and commit the changed public/build output alongside it.
/public/hot
/public/storage
/storage/*.key
/storage/pail

# /vendor is deliberately NOT ignored.
#
# Composer needs proc_open to run, and it is disabled on this host's deploy
# runner, so `composer install` fails there on every push. Committing the
# installed dependencies means the server only ever has to pull files.
#
# Consequences to know about:
#  - the tree is built with --no-dev, so phpunit, pint and faker are absent
#  - after changing composer.json, re-run:
#      composer install --no-dev --optimize-autoloader
#    and commit the resulting vendor/ changes along with composer.lock
Homestead.json
Homestead.yaml
Thumbs.db
